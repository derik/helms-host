# Helm's Host settings. Copy to .env only if absent; shell variables override it.
# Literal KEY=value; matching outer quotes allowed. No variable expansion or
# shell commands; put comments on their own lines.

LLAMA_MODELS_DIR=/srv/ai/models
# Exact drive mount point. Use /srv if that is where the drive is mounted.
# Empty only for intentional storage on the root filesystem.
LLAMA_STORAGE_MOUNT=/srv/ai
HOST_PORT=8080
CTX_SIZE=131072
GPU_LAYERS=99

IMAGE_NAME=local/helms-host:b820cc8e6f94
CONTAINER_NAME=local-helms-host
# DOCKER="sudo docker"
# HF_TOKEN=your-token-for-gated-models
